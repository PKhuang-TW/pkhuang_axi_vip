---
# Note: The contents of this file are automatically generated.
# Any changes made by hand may be overwritten.
version: '0.2'
work_dir: .
design_root_dir: .
simulations:
  - name: simulation
    options: >-
      -image image -uvm 1.2 -waves waves.mxd +UVM_NO_RELNOTES
      +UVM_TESTNAME=test_axi_outstanding_write_random +UVM_VERBOSITY=UVM_MEDIUM
  - name: elaboration
    options: '-top work.sim_top -genimage image -uvm 1.2 +acc+b -F filelist.lst'
source_files:
  - language: verilog
    path: tb\sim_top.sv
    options: '-uvm 1.2 -F filelist.lst'
library_search_paths:
  - $STD_LIBS\ieee93
